{
  "rewrites": [
    {
      "source": "/f1-news",
      "destination": "https://www.formula1.com/en/latest/all.xml"
    },
    {
      "source": "/f1-article/en/latest/:path*",
      "destination": "https://www.formula1.com/en/latest/:path*"
    },
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/schedule",
      "destination": "/schedule.html"
    },
    {
      "source": "/schedule/",
      "destination": "/schedule.html"
    },
    {
      "source": "/results",
      "destination": "/results.html"
    },
    {
      "source": "/results/",
      "destination": "/results.html"
    },
    {
      "source": "/standings",
      "destination": "/standings.html"
    },
    {
      "source": "/standings/",
      "destination": "/standings.html"
    },
    {
      "source": "/constructor-standings",
      "destination": "/constructor-standings.html"
    },
    {
      "source": "/constructor-standings/",
      "destination": "/constructor-standings.html"
    },
    {
      "source": "/statistics",
      "destination": "/statistics.html"
    },
    {
      "source": "/statistics/",
      "destination": "/statistics.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/race/:season/:slug",
      "destination": "/race/:season/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://accounts.google.com/gsi/client https://www.googletagmanager.com https://www.clarity.ms https://scripts.clarity.ms; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https://livetiming.formula1.com; connect-src 'self' https:; frame-src https://accounts.google.com/gsi/; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin-portal",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/f1-news",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/f1-article/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
